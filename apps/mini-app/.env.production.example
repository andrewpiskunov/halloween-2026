# Боевые настройки: скопировать в .env рядом с docker-compose.yml и заполнить.
# Токен и секрет в Git не кладите.
BOT_TOKEN=
BOT_NAME=
SESSION_SECRET=
CLIENT_URL=https://example.org/fair/
BOT_POLLING=1
ALLOW_DEV_AUTH=0
# Поправки содержимого на вечер (имена и тексты ролей), файл из apps/mini-app/content; пусто = без поправок
CONTENT_PATCH_PATH=
# Подстановки в docker-compose.yml
BASE_PATH=/fair/
WEB_PORT=3500
