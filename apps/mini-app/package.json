{
  "name": "fair-mini-app",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "start": "pnpm --filter @fair/server start",
    "e2e": "playwright test -c e2e",
    "sim": "pnpm --filter @fair/sim sim",
    "sim:load": "pnpm --filter @fair/sim load",
    "sim:bench": "pnpm --filter @fair/sim bench",
    "e2e:hidden17": "playwright test -c e2e/hidden17.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
